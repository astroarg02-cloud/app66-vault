{
  "entities": {
    "VaultItem": {
      "title": "VaultItem",
      "description": "A resource item in the VIP Vault",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "fileType": { "type": "string" },
        "fileSize": { "type": "string" },
        "fileName": { "type": "string" },
        "fileMimeType": { "type": "string" },
        "downloadUrl": { "type": "string" },
        "coverImage": { "type": "string" },
        "createdAt": { "type": "string" },
        "likesCount": { "type": "number" },
        "likedBy": { "type": "array" },
        "comments": { "type": "array" },
        "isLockedForTier": { "type": "boolean" },
        "version": { "type": "string" }
      },
      "required": ["id", "title", "description", "category"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Registered user account and profile in the application",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "password": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string" },
        "tier": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "joinedAt": { "type": "string" },
        "registeredAt": { "type": "string" },
        "bio": { "type": "string" },
        "phone": { "type": "string" },
        "customStatus": { "type": "string" },
        "instagram": { "type": "string" },
        "membershipPlan": { "type": "string" },
        "membershipStatus": { "type": "string" },
        "subscribedAt": { "type": "string" },
        "membershipExpiresAt": { "type": "string" },
        "lastPaymentAmount": { "type": "number" }
      },
      "required": ["uid", "email"]
    },
    "PaymentReceipt": {
      "title": "PaymentReceipt",
      "description": "Payment receipt uploaded by a user for VIP membership approval",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userDisplayName": { "type": "string" },
        "userEmail": { "type": "string" },
        "userAvatar": { "type": "string" },
        "plan": { "type": "string" },
        "amount": { "type": "number" },
        "currency": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "referenceCode": { "type": "string" },
        "receiptImageUrl": { "type": "string" },
        "receiptFileName": { "type": "string" },
        "notes": { "type": "string" },
        "whatsappContact": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" },
        "reviewedAt": { "type": "string" },
        "reviewedBy": { "type": "string" },
        "adminNote": { "type": "string" },
        "membershipStartsAt": { "type": "string" },
        "membershipExpiresAt": { "type": "string" }
      },
      "required": ["id", "userId", "plan", "status", "createdAt"]
    }
  },
  "firestore": {
    "/vault_items/{itemId}": {
      "schema": "VaultItem",
      "description": "All public and VIP vault items"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Registered user profile records"
    },
    "/payment_receipts/{receiptId}": {
      "schema": "PaymentReceipt",
      "description": "Uploaded payment receipts for membership approval"
    }
  }
}
