rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /vault_items/{itemId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    match /{document=**} {
      allow read, write: if true;
    }
  }
}
